        {
          "expr": "kube_deployment_status_replicas_available",
          "legendFormat": "{{namespace}}/{{deployment}} - Available",
          "refId": "B"
        }
      ],
      "title": "Desired vs Available Replicas",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_updated",
          "legendFormat": "{{namespace}}/{{deployment}} - Updated",
          "refId": "A"
        },
        {
          "expr": "kube_deployment_status_replicas_ready",
          "legendFormat": "{{namespace}}/{{deployment}} - Ready",
          "refId": "B"
        }
      ],
