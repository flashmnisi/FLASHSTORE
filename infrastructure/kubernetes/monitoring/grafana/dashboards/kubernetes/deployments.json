      ],
      "title": "Deployment Conditions (Available, Progressing)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "Replicas Unavailable",
